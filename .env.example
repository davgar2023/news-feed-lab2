NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://newsfeed_app:newsfeed_app@postgres:5432/newsfeed
DATABASE_OWNER_URL=postgres://newsfeed_owner:newsfeed_owner@postgres:5432/newsfeed
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
REDIS_URL=redis://redis:6379
REDIS_MAX_RETRIES_PER_REQUEST=3
RABBITMQ_URL=amqp://newsfeed:newsfeed@rabbitmq:5672
CELEBRITY_THRESHOLD=100000
TIMELINE_MAX_ITEMS=1000
OUTBOX_POLL_INTERVAL_MS=500
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RECONNECT_DELAY_MS=1000
TRUST_PROXY=true
